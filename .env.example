# Balas Kilat backend environment — variable NAMES only.
# Copy to .env (git-ignored) or export in your shell. Never commit values.

# Telegram bot token from BotFather. Leave unset to run in MOCK mode
# (seeded fake messages, sends only logged).
TELEGRAM_BOT_TOKEN=

# OR use the Muse vault connector instead of a raw token:
# TELEGRAM_VIA_CONNECTOR=1

# Backend listen port.
PORT=8787

# Path to the LLM relay helper (hms.py) used for reply drafts.
HMS_HELPER=
